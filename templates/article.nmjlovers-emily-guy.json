        "enable_newsletter_subscribe": false,
        "klaviyo_form_id": "",
        "media_position": "right",
        "media_position_mobile": "bottom",
        "media_width": "7",
        "content_position": "middleLeft",
        "subheading": "",
        "title": "<p>“We’ve grown up alongside one another, <em>choosing each other through every season</em> and creating a life filled with more adventure and memories than I ever could have dreamed of.”</p>",
        "description": "",
        "colour_style": "dark",
