    "faq_group_gwn8VE": {
      "type": "faq-group",
      "blocks": {
        "question_UF7bQG": {
          "type": "question",
          "name": "Can I return or exchange my order?",
          "settings": {
            "question": "Can I return or exchange my order?",
            "answer": "<p>Return eligibility depends on whether your piece is Made to Order, Ready to Ship, an earring or an Archive Sale piece.</p><p>As Made to Order pieces are handcrafted especially for you, they cannot be returned, exchanged, refunded or credited for change of mind.</p><p>Eligible full price Ready to Ship pieces may be returned for an exchange or credit note within 14 days of receipt, provided all return conditions are met.</p><p>Please see our return policy for more information.</p>"
          }
        },
        "question_zQmbUx": {
          "type": "question",
          "name": "How do I return an eligible item?",
          "settings": {
            "question": "How do I return an eligible item?",
            "answer": "<p>To arrange a return, please contact our Customer Service team or bring your piece into one of our showrooms. Our team will carefully assess the item against the conditions of our Returns Policy and confirm the outcome with you.</p><p>We recommend contacting us before returning your piece by post so we can provide the appropriate instructions and ensure it arrives safely.</p><p></p>"
          }
        },
        "question_KgXcwX": {
          "type": "question",
          "name": "What should I do if I believe my piece is faulty or incorrectly described?",
          "settings": {
            "question": "What should I do if I believe my piece is faulty or incorrectly described?",
            "answer": "<p>Please contact our Customer Service team with your order details and information about the issue. Photographs can also be helpful in allowing our team to make an initial assessment.</p><p>We will carefully review your concerns and guide you through the next steps. Please see our return policy for more information.</p>"
          }
        },
        "question_gNr8AT": {
          "type": "question",
          "name": "How can I return a gift?",
          "settings": {
            "question": "How can I return a gift?",
            "answer": "<p>If you have received an NMJ piece as a gift and would like to return it, please contact our Customer Care team or visit one of our showrooms. Where possible, please provide the original order number or the purchaser’s details so our team can locate the order.</p><p>Eligible gift returns will be assessed in accordance with our Returns Policy.</p>"
          }
        },
        "question_ktJN7y": {
          "type": "question",
          "name": "Why may a restocking fee apply?",
          "settings": {
            "question": "Why may a restocking fee apply?",
            "answer": "<p>A restocking fee may apply to an approved change-of-mind return to help cover the costs associated with carefully inspecting, processing and preparing the piece to be returned to our collection.</p><p>Any applicable fee will be clearly communicated before your return is finalised.</p>"
          }
        }
      },
