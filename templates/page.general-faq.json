    "faq_group_z3CNQg": {
      "type": "faq-group",
      "blocks": {
        "question_DqRyqN": {
          "type": "question",
          "name": "Where are your showrooms located?",
          "settings": {
            "question": "Where are your showrooms located?",
            "answer": "<p>We would love to welcome you into one of our Sydney showrooms:</p><p>Avalon Beach</p><p>43 Old Barrenjoey Road, Avalon Beach</p><p>Paddington</p><p>70 William Street, Paddington</p><p>Please check our current opening hours before visiting, as these may vary seasonally.</p>"
          }
        },
        "question_GjKdRN": {
          "type": "question",
          "name": "Do I need an appointment, and what types of appointments do you offer?",
          "settings": {
            "question": "Do I need an appointment, and what types of appointments do you offer?",
            "answer": "<p>You are always welcome to visit our showrooms without an appointment. However, if you would prefer a more personalised experience, we offer dedicated engagement, ceremonial and bespoke appointments.</p><p>During your appointment, a member of our team will guide you through the collection, answer your questions and help you explore the pieces and options best suited to you.</p>"
          }
        },
        "question_QckEYg": {
          "type": "question",
          "name": "Is every online piece available to view in your showrooms?",
          "settings": {
            "question": "Is every online piece available to view in your showrooms?",
            "answer": "<p>While we aim to have an example of each design available to view across our showrooms, this is not always possible.</p><p>If there is a particular piece you would like to see, please contact our Customer Service team before visiting. They will be happy to confirm whether the piece is available to view and advise which showroom currently has it in stock.</p>"
          }
        },
        "question_LJyPNw": {
          "type": "question",
          "name": "Can I collect an online order from one of your showrooms?",
          "settings": {
            "question": "Can I collect an online order from one of your showrooms?",
            "answer": "<p>Our Customer Service team will contact you as soon as your order is ready to collect.</p><p>Please wait until you receive this confirmation before visiting your selected showroom, as collection availability and timing will depend on the piece, its production requirements and the chosen location.</p>"
          }
        },
        "question_jNLpqz": {
          "type": "question",
          "name": "Can I bring my jewellery into a showroom for assessment or servicing?",
          "settings": {
            "question": "Can I bring my jewellery into a showroom for assessment or servicing?",
            "answer": "<p>You are welcome to bring your NMJ piece into either of our showrooms for assessment or servicing. Your jewellery will be carefully photographed and logged, and we will email you to confirm that it is safely in our care, along with a unique reference number.</p><p>Our Production team will then assess the work required and provide you with a personalised quotation and estimated timeframe before proceeding.</p><p>We also offer complimentary ultrasonic cleaning for suitable NMJ pieces while you wait in the showroom. Please note that we are only able to assess, service or clean jewellery purchased from NMJ.</p>"
          }
        }
      },
      "block_order": [
