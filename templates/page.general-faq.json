    "faq_group_pGGCec": {
      "type": "faq-group",
      "blocks": {
        "question_6HhqWq": {
          "type": "question",
          "name": "What payment methods and payment plans do you offer?",
          "settings": {
            "question": "What payment methods and payment plans do you offer?",
            "answer": "<p>We accept major credit and debit cards, PayPal, Afterpay and Zippay, subject to availability. The payment methods currently available for your order will be displayed at checkout.</p><p>When using a third-party payment provider, its own eligibility requirements, spending limits, repayment arrangements, fees and terms will apply.</p>"
          }
        },
        "question_a8xLmf": {
          "type": "question",
          "name": "What should I do if my payment is not processing?",
          "settings": {
            "question": "What should I do if my payment is not processing?",
            "answer": "<p>If you are experiencing difficulty completing your payment, please contact our Customer Care team. They will be happy to assist and work with you to resolve the issue wherever possible.</p>"
          }
        },
        "question_MDwiGh": {
          "type": "question",
          "name": "  How long are your quotes valid, and can pricing change after a quote expires?",
          "settings": {
            "question": "How long are your quotes valid, and can pricing change after a quote expires?",
            "answer": "<p>Written quotes provided by Natalie Marie Jewellery are valid for 30 days from the date of issue unless otherwise specified.</p><p>As the cost of precious metals, gemstones and other materials can change over time, pricing may need to be reviewed once a quote has expired. If this occurs, our team will provide an updated quote before you proceed.</p>"
          }
        },
        "question_rXjzH6": {
          "type": "question",
          "name": "How do I use a gift card or credit note?",
          "settings": {
            "question": "How do I use a gift card or credit note?",
            "answer": "<p>When you receive an NMJ gift card or credit note, you will be provided with a unique code. To redeem it online, simply enter this code in the gift card or discount code field at checkout and select apply. The available value will then be deducted from your order total.</p><p>If your order exceeds the available balance, you can pay the remaining amount using one of our accepted payment methods. Any unused balance will remain available on the same code for a future purchase, subject to the applicable expiry date.</p><p>Please refer to our Terms & Conditions for more information regarding gift cards.</p>"
          }
        }
      },
