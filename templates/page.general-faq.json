    "faq_group_kc63Mz": {
      "type": "faq-group",
      "blocks": {
        "question_NiD4w8": {
          "type": "question",
          "name": "Are Archive Sale purchases final sale?",
          "settings": {
            "question": "Are Archive Sale purchases final sale?",
            "answer": "<p>Yes. Archive Sale purchases are final sale and cannot be returned, exchanged, refunded or credited for change of mind, incorrect sizing or minor imperfections that were disclosed.</p><p>As these pieces are offered in limited quantities and often include discontinued, sample or display designs, we encourage you to carefully review the product description, imagery, condition and sizing before purchasing.</p>"
          }
        },
        "question_wbtQtF": {
          "type": "question",
          "name": "When will my Archive Sale order be dispatched?",
          "settings": {
            "question": "When will my Archive Sale order be dispatched?",
            "answer": "<p>Please allow up to five business days for your Archive Sale order to be carefully prepared and dispatched.</p><p>Once your order has been shipped, we will send you a confirmation email containing your tracking information.</p>"
          }
        },
        "question_7jt9WB": {
          "type": "question",
          "name": "Do Archive Sale pieces come with a manufacturing warranty?",
          "settings": {
            "question": "Do Archive Sale pieces come with a manufacturing warranty?",
            "answer": "<p>Yes. Archive Sale pieces remain covered by the applicable manufacturer’s warranty in relation to eligible manufacturing or craftsmanship faults.</p>"
          }
        }
      },
      "block_order": [
